void System::Metro_step(){ //esplora la funzione d'onda con metropolis


    bool is_accepted; 

    //transizione
    int i= int(_rand_gen.Rannyu(0,1)*_N);
    double new_val=_rand_gen.Rannyu(_x_min,_x_max); 
  


    //accettazione
    double p=pow(Wave_function(_x_new(i))/Wave_function(_x(i)),2);
    
    if (p>1){
        is_accepted=true ; // move is accepted 
    }else if (p>0 ) { //controllo di sicurezza
        double num=_rand_gen.Rannyu(0,1); 
        if (num < p){ //evento che ha probabilità p di avverarsi
            is_accepted=true; 
        }else{
            is_accepted=false; 
        }
    }
    _proposed++; //conta quante mosse proposte
    if (is_accepted){
        _x(i)=new_val;
        _accepted++; //conta quante mosse accettate
    }

    return; 
}







